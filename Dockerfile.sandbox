FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    python3 \
    python3-pip \
    python3-venv \
    gcc \
    g++ \
    make \
    git \
    jq \
    ripgrep \
    sqlite3 \
    tree \
    unzip \
    zip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /terminator
